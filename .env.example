APP_NAME=SIMONKEB
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- SIMONKEB ---
# kirim notifikasi alur usulan lewat email juga (atur MAIL_* di atas)
NOTIFIKASI_EMAIL=false
# peran yang wajib 2FA, pisahkan koma: admin,verifikator_bkn,validator_kemenpan
WAJIB_2FA_PERAN=

# --- Integrasi SIASN BKN (kredensial & whitelist IP diajukan ke BKN) ---
SIASN_ENABLED=false
SIASN_MODE=training
SIASN_APIM_USERNAME=
SIASN_APIM_PASSWORD=
SIASN_SSO_CLIENT_ID=
SIASN_SSO_USERNAME=
SIASN_SSO_PASSWORD=
# opsional: token SSO yang sudah didapat manual
SIASN_SSO_ACCESS_TOKEN=
# opsional: override URL bila BKN memberi alamat berbeda
SIASN_BASE_URL=
SIASN_APIM_URL=
SIASN_SSO_URL=
# sinkron pegawai otomatis tiap 01.00 (butuh `php artisan schedule:work` / cron)
SIASN_SYNC_TERJADWAL=false

# --- Login SSO SIASN (OpenID Connect; daftarkan client & redirect URI ke BKN) ---
SIASN_SSO_LOGIN=false
SIASN_OIDC_CLIENT_ID=
SIASN_OIDC_CLIENT_SECRET=
# default: APP_URL + /auth/siasn/callback
SIASN_OIDC_REDIRECT=
SIASN_OIDC_NIP_CLAIM=nip
SIASN_OIDC_SKIP_2FA=true

# --- Ambang sistem peringatan dini ---
PERINGATAN_STAGNAN_BULAN=6
PERINGATAN_DATA_USANG_BULAN=6
PERINGATAN_GEMUK_PERSEN=130
PERINGATAN_KEKURANGAN_KRITIS_PERSEN=50
PERINGATAN_USULAN_TERTAHAN_HARI=14
PERINGATAN_USULAN_DIKEMBALIKAN_HARI=30
PERINGATAN_FORMASI_BULAN=12
PERINGATAN_ABK_UMUR_TAHUN=2
PERINGATAN_PENSIUN_BULAN=12
